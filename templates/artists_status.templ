package templates

import "net/url"

// ListStatusDropdown renders an Open Props / OPUI select to change list status.
//
// Two-way bound: data-bind mirrors the selection into a signal (initialised
// from the rendered option), and the change handler reads the signal — no
// evt.target DOM reads. Backend contract unchanged (status stays in the URL).
templ ListStatusDropdown(artistID, currentStatus string) {
	{{
		ind := "_updating_" + artistID
		indSignal := "$" + ind
		bind := "_status_" + artistID
	}}
	<select
		class="select select-xs font-medium cursor-pointer status-select"
		data-status={ currentStatus }
		data-indicator={ ind }
		data-bind={ bind }
		data-attr:disabled={ indSignal }
		data-on:change={ "@post('/api/artists/" + url.PathEscape(artistID) + "/status/' + $" + bind + ")" }
		aria-label="Change status"
	>
		<option value="included" selected?={ currentStatus == "included" }>Included</option>
		<option value="recently_added" selected?={ currentStatus == "recently_added" }>Recently Added</option>
		<option value="not_added" selected?={ currentStatus == "not_added" }>Not Added</option>
		<option value="waiting" selected?={ currentStatus == "waiting" }>Move to Queue</option>
	</select>
}
