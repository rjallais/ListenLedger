package templates

// ArtistsPage renders the artists page with pagination.
templ ArtistsPage(artists []Artist, rockMetalCount, everythingElseCount int, currentGenre string, waitingCount int, pagination Pagination) {
	@Layout("Artists", "artists") {
		@ArtistsPageHeader()
		@ArtistsGenreTabs(rockMetalCount, everythingElseCount, currentGenre)
		@ArtistsTable(artists, currentGenre)
		if pagination.TotalPages > 1 {
			@PaginationControls(pagination)
		}
		if waitingCount > 0 {
			<div class="divider mt-10"></div>
			@ArtistQueueSection(waitingCount)
		}
		@AddArtistModal(currentGenre)
		@BatchRefreshModal()
	}
}

templ ArtistsPageHeader() {
	<div class="flex justify-between items-center mb-6">
		<h1 class="text-3xl font-bold">Artists</h1>
		<div class="flex gap-2">
			<label for="batch-refresh-modal" class="btn btn-secondary gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
				Batch Refresh
			</label>
			<label for="add-artist-modal" class="btn btn-primary gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
				</svg>
				Add Artist
			</label>
		</div>
	</div>
}

templ ArtistsGenreTabs(rockMetalCount, everythingElseCount int, currentGenre string) {
	<div role="tablist" class="tabs tabs-boxed mb-6">
		@GenreTab("/artists?genre=rock_metal", "🎸 Rock & Metal", rockMetalCount, currentGenre == "rock_metal")
		@GenreTab("/artists?genre=everything_else", "🎵 Everything Else", everythingElseCount, currentGenre == "everything_else")
	</div>
}

// GenreTab renders a genre tab link.
templ GenreTab(href, label string, count int, active bool) {
	<a
		href={ templ.SafeURL(href) }
		role="tab"
		class={ "tab", templ.KV("tab-active", active) }
	>
		{ label } ({ intString(count) })
	</a>
}
