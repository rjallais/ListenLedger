package templates

import (
	"fmt"
	"net/url"
	"strconv"
)

// NotRecentSongRows appends not-recent songs and updates pagination controls.
templ NotRecentSongRows(songs []Song, nextOffset int, hasMore bool, playlistSort string) {
	<tbody id="songs-not-recent">
		for _, song := range songs {
			@SongRow(song, playlistSort)
		}
	</tbody>
	@NotRecentSongsLoadMore(nextOffset, hasMore, playlistSort)
}

templ NotRecentSongsLoadMore(nextOffset int, hasMore bool, playlistSort string) {
	<div id="load-more-songs-not-recent" class="mt-4 text-center">
		if hasMore {
			<button
				class="btn btn-outline btn-sm"
				data-on:click={ songsNotRecentURL(nextOffset, playlistSort) }
			>
				Load More ({ fmt.Sprintf("%d", nextOffset) } loaded)
			</button>
		} else {
			<p class="text-sm text-success">✓ All archived songs loaded</p>
		}
	</div>
}

func songsNotRecentURL(offset int, playlistSort string) string {
	query := url.Values{
		"offset":        []string{strconv.Itoa(offset)},
		"limit":         []string{"50"},
		"playlist_sort": []string{playlistSort},
	}
	return fmt.Sprintf("@get('/api/songs/not-recent?%s')", query.Encode())
}
