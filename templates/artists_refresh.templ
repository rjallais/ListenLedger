package templates

import "fmt"

// FetchStatusDot renders a small colored dot representing the fetch status.
templ FetchStatusDot(status string) {
	if status == "pending" {
		<span class="w-2 h-2 rounded-full bg-warning animate-pulse" title="Fetching..."></span>
		<span role="status" aria-live="polite" class="sr-only">Fetching</span>
	} else if status == "failed" {
		<span class="w-2 h-2 rounded-full bg-error" title="Fetch failed"></span>
		<span role="status" aria-live="polite" class="sr-only">Fetch failed</span>
	}
}

// ArtistRefreshAction renders the refresh control for an artist.
templ ArtistRefreshAction(artist Artist) {
	{{
		ind := "_refreshing_" + artist.ID
		indSignal := "$" + ind
		notIndSignal := "!$" + ind
		isDisabledExpr := fmt.Sprintf("%s || %t", indSignal, artist.FetchStatus == "pending")
	}}
	<div class="flex items-center justify-center gap-1">
		@FetchStatusDot(artist.FetchStatus)
		<button
			type="button"
			class="btn btn-xs btn-ghost btn-square"
			data-indicator={ ind }
			data-attr:disabled={ isDisabledExpr }
			data-on:click={ artistRefreshPostAction(artist.ID) }
			disabled?={ artist.FetchStatus == "pending" }
			aria-label="Refresh monthly listeners"
			title="Refresh monthly listeners"
		>
			<span data-show={ indSignal } class="loading loading-spinner loading-xs" style="display: none"></span>
			<span data-show={ notIndSignal } class="icon icon-refresh text-xs"></span>
		</button>
		<button
			type="button"
			class="btn btn-xs btn-ghost btn-square"
			data-on:click={ artistHistoryDrawerAction(artist.ID) }
			aria-label="View history and trajectory"
			title="View listener trajectory & history"
		>
			<span class="icon icon-trend text-xs text-muted-foreground hover:text-foreground"></span>
		</button>
	</div>
}
