package templates

// FetchStatusDot renders a small colored dot that binds to fetch status signal.
templ FetchStatusDot(artistID string) {
	<span class="w-2 h-2 rounded-full bg-warning animate-pulse" title="Fetching..." data-show={ artistFetchStatusSignal(artistID) + " === 'pending'" }></span>
	<span class="w-2 h-2 rounded-full bg-error" title="Fetch failed" data-show={ artistFetchStatusSignal(artistID) + " === 'failed'" }></span>
	<span role="status" aria-live="polite" class="sr-only" data-show={ artistFetchStatusSignal(artistID) + " === 'pending'" }>Fetching</span>
	<span role="status" aria-live="polite" class="sr-only" data-show={ artistFetchStatusSignal(artistID) + " === 'failed'" }>Fetch failed</span>
}

// ArtistRefreshAction renders the refresh control bound to fetch status signal.
templ ArtistRefreshAction(artistID string) {
	<div class="flex items-center justify-center gap-1">
		@FetchStatusDot(artistID)
		<button
			class="btn btn-xs btn-primary"
			data-on:click={ artistRefreshPostAction(artistID) }
			data-attr-disabled={ artistFetchStatusSignal(artistID) + " === 'pending' ? '' : null" }
			aria-label="Refresh monthly listeners"
			title="Refresh monthly listeners"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
			</svg>
		</button>
	</div>
}
