package templates

import (
	"fmt"
	"net/url"

	"github.com/starfederation/datastar-go/datastar"
)

templ IconPlus(className string) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ className } fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
	</svg>
}

templ IconMinus(className string) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ className } fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
	</svg>
}

templ IconEye(className string) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ className } fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
	</svg>
}

templ IconChevronDown(className string) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ className } fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
	</svg>
}

templ IconDoubleArrow(className string) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ className } fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
	</svg>
}

templ IconCheck(className string) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ className } fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
	</svg>
}

// AlbumRow renders a single album table row.
templ AlbumRow(album Album) {
	<tr id={ "album-" + album.ID }>
		<td class="font-medium">{ album.Title }</td>
		<td>{ album.ArtistName }</td>
		<td class="text-center">
			<div class="flex justify-center">
				@AlbumStatusDropdown(album.ID, album.Status)
			</div>
		</td>
		<td class="text-right">
			@AlbumSongControls(album)
		</td>
	</tr>
}

// AlbumCard renders an album as a card (for waiting section).
templ AlbumCard(album Album) {
	<div id={ "album-card-" + album.ID } class="card bg-base-200 shadow-sm">
		<div class="card-body py-3 px-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h3 class="font-medium">{ album.Title }</h3>
					<p class="text-sm text-base-content/70">{ album.ArtistName }</p>
				</div>
				<div class="flex items-center gap-3">
					@AlbumSongControls(album)
					@AlbumStatusDropdown(album.ID, album.Status)
				</div>
			</div>
		</div>
	</div>
}

// AlbumSongCounter renders a single increment/decrement counter row.
templ AlbumSongCounter(label, albumID, field string, count int) {
	<div class="flex items-center gap-1">
		<span class="text-xs opacity-60">{ label }</span>
		@AlbumSongAdjustButton(albumID, field, "dec", "Decrease "+label+" songs")
		<span class="font-mono min-w-[2.5rem] text-center">{ fmt.Sprintf("%d", count) }</span>
		@AlbumSongAdjustButton(albumID, field, "inc", "Increase "+label+" songs")
	</div>
}

templ AlbumSongAdjustButton(albumID, field, op, title string) {
	{{
		ind := fmt.Sprintf("_adj_%s_%s_%s", albumID, field, op)
		indSignal := "$" + ind
		notIndSignal := "!$" + ind
	}}
	<button
		class="btn btn-xs btn-ghost btn-square"
		data-indicator={ ind }
		data-attr:disabled={ indSignal }
		data-on:click={ albumSongAdjustURL(albumID, field, op) }
		title={ title }
		aria-label={ title }
	>
		<span data-show={ indSignal } class="loading loading-spinner loading-xs" style="display: none"></span>
		<span data-show={ notIndSignal }>
			if op == "inc" {
				@IconPlus("h-3 w-3")
			} else {
				@IconMinus("h-3 w-3")
			}
		</span>
	</button>
}

templ AlbumStatusOption(albumID, currentStatus, status, badgeTone, label string) {
	{{
		ind := "_upd_album_" + albumID
		indSignal := "$" + ind
		notIndSignal := "!$" + ind
	}}
	<li>
		<button
			class={ "text-left", templ.KV("active", currentStatus == status) }
			data-indicator={ ind }
			data-attr:disabled={ indSignal }
			data-on:click={ albumStatusUpdateURL(albumID, status) + "; el.closest('details')?.removeAttribute('open')" }
		>
			<span data-show={ indSignal } class="loading loading-spinner loading-xs" style="display: none"></span>
			<span data-show={ notIndSignal } class={ "badge", "badge-xs", badgeTone }></span>
			{ label }
		</button>
	</li>
}

// AlbumSongControls renders collection and total song controls.
templ AlbumSongControls(album Album) {
	<div class="flex flex-col items-end gap-1">
		@AlbumSongCounter("Owned", album.ID, "collection", album.CollectionSongs)
		@AlbumSongCounter("Total", album.ID, "total", album.TotalSongs)
	</div>
}

// AlbumStatusDropdown renders a dropdown to change album status.
//
// Native <details> disclosure: opens/closes without JavaScript focus hacks.
// Closes on outside click via data-on:click__outside and on Escape; option
// buttons close it explicitly after firing. No global document listeners.
templ AlbumStatusDropdown(albumID, currentStatus string) {
	<details
		class="dropdown dropdown-end"
		data-on:click__outside="el.removeAttribute('open')"
		data-on:keydown="if (evt.key === 'Escape') el.removeAttribute('open')"
	>
		<summary class="btn btn-xs btn-ghost gap-1" aria-label="Change album status">
			@AlbumStatusBadge(currentStatus)
			@IconChevronDown("h-3 w-3")
		</summary>
		<ul class="dropdown-content z-50 menu p-2 shadow-xl bg-base-100 border border-base-300 rounded-box w-40">
			@AlbumStatusOption(albumID, currentStatus, "full", "badge-success", "Full")
			@AlbumStatusOption(albumID, currentStatus, "processed", "badge-warning", "Processed")
			@AlbumStatusOption(albumID, currentStatus, StatusWaiting, "badge-ghost", "Waiting")
		</ul>
	</details>
}

// AlbumStatusBadge renders the current album status as a badge.
templ AlbumStatusBadge(status string) {
	switch status {
		case "full":
			<span class="badge badge-success badge-sm">full</span>
		case "processed":
			<span class="badge badge-warning badge-sm">processed</span>
		case StatusWaiting:
			<span class="badge badge-ghost badge-sm">waiting</span>
		default:
			<span class="badge badge-ghost badge-sm">unknown</span>
	}
}

templ AddAlbumSuccessNotice(albumTitle string) {
	<div id="add-album-feedback" class="mt-2" data-signals="{ _feedbackVisible: true }" data-show="$_feedbackVisible">
		<div class="alert alert-success">
			@IconCheck("h-5 w-5")
			<div class="flex-1">
				<p class="font-semibold">Album added</p>
				<p class="text-xs">{ albumTitle }</p>
			</div>
			<button type="reset" form="add-album-form" class="btn btn-success btn-sm" data-on:click="$_feedbackVisible = false">Add Another</button>
			<button type="button" class="btn btn-ghost btn-sm" data-sb-close>Close</button>
		</div>
	</div>
}

templ AddAlbumErrorNotice(errMsg string) {
	<div id="add-album-feedback" class="mt-2" data-signals="{ _feedbackVisible: true }" data-show="$_feedbackVisible">
		<div class="alert alert-error">
			<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
			<div class="flex-1">
				<p class="font-semibold">Failed to add album</p>
				<p class="text-xs">{ errMsg }</p>
			</div>
			<button type="button" class="btn btn-ghost btn-sm" data-on:click="$_feedbackVisible = false">Dismiss</button>
		</div>
	</div>
}

// AddAlbumModal renders the modal for adding a new album.
//
// Declarative open state: triggers set $_add_album_open; sb-modal reflects
// the open attribute through its bool prop and resets the signal on sb-close
// (button, backdrop, or Escape). The backend can drive it via patch-signals.
templ AddAlbumModal() {
	<sb-modal
		data-signals="{_add_album_open: false}"
		data-attr:open="$_add_album_open"
		data-on:sb-close="$_add_album_open = false"
		heading="Add New Album"
	>
		@AddAlbumForm()
		<div id="add-album-feedback" class="mt-2"></div>
		@AddAlbumModalActions()
	</sb-modal>
}

// AddAlbumForm renders the form elements for adding a new album.
templ AddAlbumForm() {
	<form
		id="add-album-form"
		data-indicator:_loading
		data-on:submit__prevent="!$_loading && @post('/api/albums', {contentType: 'form'})"
	>
		<div class="form-control w-full mb-4">
			<label class="label" for="album-title">
				<span class="label-text">Album Title *</span>
			</label>
			<input
				id="album-title"
				type="text"
				name="title"
				placeholder="Enter album title"
				class="input input-bordered w-full"
				required
			/>
		</div>
		<div class="form-control w-full mb-4">
			<label class="label" for="album-artist-name">
				<span class="label-text">Artist Name *</span>
			</label>
			<input
				id="album-artist-name"
				type="text"
				name="artist_name"
				placeholder="Enter artist name"
				class="input input-bordered w-full"
				required
			/>
		</div>
		<div class="form-control w-full mb-4">
			<label class="label" for="album-status">
				<span class="label-text">Status</span>
			</label>
			<select id="album-status" name="status" class="select select-bordered w-full">
				<option value={ StatusWaiting } selected>Waiting</option>
				<option value="processed">Processed</option>
				<option value="full">Full</option>
			</select>
		</div>
		<div class="grid grid-cols-2 gap-4 mb-6">
			<div class="form-control w-full">
				<label class="label" for="album-collection-songs">
					<span class="label-text">Owned Songs</span>
					<span class="label-text-alt text-base-content/50">Optional</span>
				</label>
				<input
					id="album-collection-songs"
					type="number"
					name="collection_songs"
					placeholder="0"
					min="0"
					class="input input-bordered w-full"
				/>
			</div>
			<div class="form-control w-full">
				<label class="label" for="album-total-songs">
					<span class="label-text">Total Songs</span>
					<span class="label-text-alt text-base-content/50">Optional</span>
				</label>
				<input
					id="album-total-songs"
					type="number"
					name="total_songs"
					placeholder="0"
					min="0"
					class="input input-bordered w-full"
				/>
			</div>
		</div>
	</form>
}

templ AddAlbumModalActions() {
	<div slot="footer" class="flex justify-end gap-2">
		<button type="button" class="btn btn-ghost" data-sb-close>Cancel</button>
		<button type="submit" form="add-album-form" class="btn btn-primary" data-attr:disabled="$_loading">
			<span data-show="$_loading" class="loading loading-spinner loading-xs" style="display: none"></span>
			Add Album
		</button>
	</div>
}

func albumsStatusURL(status string, offset int) string {
	return datastar.GetSSE("/api/albums/%s?offset=%d", status, offset)
}

func albumsWaitingURL(offset int) string {
	return datastar.GetSSE("/api/albums/waiting?offset=%d&limit=1", offset)
}

func albumSongAdjustURL(albumID, field, op string) string {
	return datastar.PostSSE("/api/albums/%s/%s/%s",
		url.PathEscape(albumID),
		url.PathEscape(field),
		url.PathEscape(op),
	)
}

func albumStatusUpdateURL(albumID, status string) string {
	return datastar.PostSSE("/api/albums/%s/status/%s", url.PathEscape(albumID), url.PathEscape(status))
}

func sectionBorderClass(color string) string {
	switch color {
	case "success":
		return "bg-success/10 border-success"
	case "warning":
		return "bg-warning/10 border-warning"
	default:
		return "bg-base-100 border-base-300"
	}
}

func badgeClass(color string) string {
	switch color {
	case "success":
		return "badge-success"
	case "warning":
		return "badge-warning"
	default:
		return "badge-ghost"
	}
}
