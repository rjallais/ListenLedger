package templates

import "fmt"

templ SongSortControls(playlistSort string) {
	<div class="flex flex-wrap items-center gap-2 mb-4">
		<span class="text-sm opacity-70">Sort by:</span>
		@SongSortButton("added_desc", "Most Recently Added", playlistSort)
		@SongSortButton("release_asc", "Release Date (Oldest First)", playlistSort)
	</div>
}

templ SongSortButton(sortValue, label, playlistSort string) {
	<button
		class={ "btn btn-sm", templ.KV("btn-primary", playlistSort == sortValue), templ.KV("btn-outline", playlistSort != sortValue) }
		data-on:click={ songsSectionsSortURL(sortValue) }
	>
		{ label }
	</button>
}

func songsSectionsSortURL(sortValue string) string {
	return fmt.Sprintf("@get('/api/songs/sections?playlist_sort=%s')", sortValue)
}
