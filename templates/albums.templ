package templates

// AlbumsPage renders the albums collection page with lazy-loaded sections.
templ AlbumsPage(fullCount, processedCount, waitingCount int) {
	@Layout("Albums", "albums") {
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold">Albums Collection</h1>
			<label for="add-album-modal" class="btn btn-primary gap-2">
				@IconPlus("h-5 w-5")
				Add Album
			</label>
		</div>
		<div class="space-y-4">
			@AlbumSectionLazy("full", "Full", "Complete Albums", "success", fullCount)
			@AlbumSectionLazy("processed", "Processed", "Partially Complete", "warning", processedCount)
			@AlbumSectionWaiting(StatusWaiting, "Waiting", "Not Yet Processed", waitingCount)
		</div>
		@AddAlbumModal()
	}
}
