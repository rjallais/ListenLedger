package templates

import "fmt"

// SongsPage renders the songs dashboard in three tiers.
templ SongsPage(currentPlaylistSongs, waitingRemovalSongs []Song, notRecentCount int, playlistSort string) {
	@Layout("Songs", "songs") {
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold">Songs Rotation</h1>
			<label for="add-song-modal" class="btn btn-primary gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
				</svg>
				Add Song
			</label>
		</div>
		<p class="mb-4 text-base-content/70">Current playlist keeps the newest 500 recent songs. Older recent songs wait for removal.</p>
		@SongsSections(currentPlaylistSongs, waitingRemovalSongs, notRecentCount, playlistSort)
		@AddSongModal()
	}
}

// SongsSections renders all three tier sections and can be morphed via Datastar.
templ SongsSections(currentPlaylistSongs, waitingRemovalSongs []Song, notRecentCount int, playlistSort string) {
	<div id="songs-sections" data-merge-mode="morph" class="space-y-4">
		@CurrentPlaylistSection(currentPlaylistSongs, playlistSort)
		<div class="collapse collapse-arrow border bg-warning/10 border-warning">
			<input type="checkbox" aria-label="Toggle waiting for removal section"/>
			<div class="collapse-title text-xl font-medium flex items-center gap-2">
				<span class="badge badge-warning">Waiting For Removal</span>
				<span>{ fmt.Sprintf("Older recent songs (%d)", len(waitingRemovalSongs)) }</span>
			</div>
			<div class="collapse-content">
				@SongSortControls(playlistSort)
				@SongSectionTable("songs-waiting-removal", waitingRemovalSongs, playlistSort)
			</div>
		</div>
		<div class="collapse collapse-arrow border bg-base-100 border-base-300">
			<input type="checkbox" class="songs-not-recent-toggle" aria-label="Toggle not recent songs section"/>
			<div class="collapse-title text-xl font-medium flex items-center gap-2">
				<span class="badge badge-ghost">Not Recent</span>
				<span>{ fmt.Sprintf("Archived songs (%d)", notRecentCount) }</span>
			</div>
			<div class="collapse-content">
				<p class="text-sm text-base-content/70 mb-4">This section is expandable and paginated.</p>
				<div class="overflow-x-auto">
					<table class="table table-zebra">
						@SongTableHeader()
						<tbody id="songs-not-recent"></tbody>
					</table>
				</div>
				<div id="load-more-songs-not-recent" class="mt-4 text-center">
					if notRecentCount > 0 {
						<button class="btn btn-outline btn-sm" data-on:click={ "@get('/api/songs/not-recent?offset=0&limit=50&playlist_sort=" + playlistSort + "')" }>Load Songs</button>
					} else {
						<p class="text-sm text-success">✓ No archived songs</p>
					}
				</div>
			</div>
		</div>
	</div>
}

// CurrentPlaylistSection renders the top playlist section and sort controls.
templ CurrentPlaylistSection(currentPlaylistSongs []Song, playlistSort string) {
	<div id="songs-current-playlist-section" data-merge-mode="morph" class="collapse collapse-arrow border bg-success/10 border-success">
		<input type="checkbox" checked aria-label="Toggle current playlist section"/>
		<div class="collapse-title text-xl font-medium flex items-center gap-2">
			<span class="badge badge-success">Current Playlist</span>
			<span>{ fmt.Sprintf("Newest 500 (%d)", len(currentPlaylistSongs)) }</span>
		</div>
		<div class="collapse-content">
			@SongSortControls(playlistSort)
			@SongSectionTable("songs-current", currentPlaylistSongs, playlistSort)
		</div>
	</div>
}

templ SongSortControls(playlistSort string) {
	<div class="flex flex-wrap items-center gap-2 mb-4">
		<span class="text-sm opacity-70">Sort by:</span>
		<button
			class={ "btn btn-sm", templ.KV("btn-primary", playlistSort == "added_desc"), templ.KV("btn-outline", playlistSort != "added_desc") }
			data-on:click="@get('/api/songs/sections?playlist_sort=added_desc')"
		>
			Most Recently Added
		</button>
		<button
			class={ "btn btn-sm", templ.KV("btn-primary", playlistSort == "release_asc"), templ.KV("btn-outline", playlistSort != "release_asc") }
			data-on:click="@get('/api/songs/sections?playlist_sort=release_asc')"
		>
			Release Date (Oldest First)
		</button>
	</div>
}

// SongSectionTable renders a song table for a fixed section.
templ SongSectionTable(tbodyID string, songs []Song, playlistSort string) {
	<div class="overflow-x-auto">
		<table class="table table-zebra">
			@SongTableHeader()
			<tbody id={ tbodyID }>
				for _, song := range songs {
					@SongRow(song, playlistSort)
				}
			</tbody>
		</table>
	</div>
}

// SongTableHeader renders shared song table columns.
templ SongTableHeader() {
	<thead>
		<tr>
			<th>Title</th>
			<th>Artist</th>
			<th>Release</th>
			<th>Type</th>
			<th>Release Date</th>
			<th class="text-center">Batch</th>
			<th class="text-center">Recently Added</th>
		</tr>
	</thead>
}

// SongRow renders a single song row.
templ SongRow(song Song, playlistSort string) {
	<tr id={ "song-" + song.ID }>
		<td class="font-medium">{ song.Title }</td>
		<td>{ song.ArtistName }</td>
		<td>{ song.Album }</td>
		<td>
			if song.ReleaseType != "" {
				<span class="badge badge-outline badge-sm">{ song.ReleaseType }</span>
			}
		</td>
		<td>{ song.ReleaseDate }</td>
		<td class="text-center">
			if song.BatchSeq > 0 {
				<span class="badge badge-primary badge-sm">{ fmt.Sprintf("B%d.%d", song.BatchSeq, song.BatchPos) }</span>
			} else {
				<span class="text-base-content/40">—</span>
			}
		</td>
		<td class="text-center">
			<input
				type="checkbox"
				class="checkbox checkbox-sm checkbox-primary"
				checked?={ song.IsRecent }
				data-on:change={ "if (evt.target.checked) { @post('/api/songs/" + song.ID + "/recent/true?playlist_sort=" + playlistSort + "') } else { @post('/api/songs/" + song.ID + "/recent/false?playlist_sort=" + playlistSort + "') }" }
			/>
		</td>
	</tr>
}

// NotRecentSongRows appends not-recent songs and updates pagination controls.
templ NotRecentSongRows(songs []Song, nextOffset int, hasMore bool, playlistSort string) {
	<tbody id="songs-not-recent" data-merge-mode="append">
		for _, song := range songs {
			@SongRow(song, playlistSort)
		}
	</tbody>
	if hasMore {
		<div id="load-more-songs-not-recent" data-merge-mode="morph" class="mt-4 text-center">
			<button
				class="btn btn-outline btn-sm"
				data-on:click={ "@get('/api/songs/not-recent?offset=" + fmt.Sprintf("%d", nextOffset) + "&limit=50&playlist_sort=" + playlistSort + "')" }
			>
				Load More ({ fmt.Sprintf("%d", nextOffset) } loaded)
			</button>
		</div>
	} else {
		<div id="load-more-songs-not-recent" data-merge-mode="morph" class="mt-4 text-center">
			<p class="text-sm text-success">✓ All archived songs loaded</p>
		</div>
	}
}

// AddSongModal renders the modal for adding a new song.
templ AddSongModal() {
	<input type="checkbox" id="add-song-modal" class="modal-toggle"/>
	<div class="modal modal-bottom sm:modal-middle">
		<div class="modal-box">
			<div class="flex items-center justify-between mb-4">
				<h3 class="font-bold text-lg">Add New Song</h3>
				<label for="add-song-modal" class="btn btn-sm btn-circle btn-ghost">✕</label>
			</div>
			<form
				id="add-song-form"
				data-on:submit="evt.preventDefault(); @post('/api/songs', {contentType: 'form'})"
			>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Song Name *</span>
					</label>
					<label>
						<input
							type="text"
							name="name"
							placeholder="Enter song name"
							class="input input-bordered w-full"
							required
						/>
					</label>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Album / EP / Single Name *</span>
					</label>
					<label>
						<input
							type="text"
							name="album"
							placeholder="Enter release name"
							class="input input-bordered w-full"
							required
						/>
					</label>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Release Type *</span>
					</label>
					<select
						name="release_type"
						class="select select-bordered w-full"
						required
					>
						<option value="" disabled selected>Select type</option>
						<option value="album">Album</option>
						<option value="ep">EP</option>
						<option value="single">Single</option>
					</select>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Release Date *</span>
					</label>
					<label>
						<input
							type="date"
							name="release_date"
							class="input input-bordered w-full"
							required
						/>
					</label>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Total Songs on Release</span>
						<span class="label-text-alt text-base-content/50">Track count for the album/EP/single</span>
					</label>
					<label>
						<input
							type="number"
							name="total_songs"
							placeholder="e.g., 12"
							min="1"
							max="999"
							class="input input-bordered w-full"
						/>
					</label>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Genre for New Artists</span>
						<span class="label-text-alt text-base-content/50">Applied only when artist ID is not in PocketBase yet</span>
					</label>
					<select name="new_artist_genre" class="select select-bordered w-full">
						<option value="rock_metal" selected>Rock & Metal</option>
						<option value="everything_else">Everything Else</option>
					</select>
				</div>
				<div class="form-control w-full mb-6">
					<label class="label">
						<span class="label-text">Artist Spotify IDs *</span>
						<span class="label-text-alt text-base-content/50">Comma-separated for multiple</span>
					</label>
					<label>
						<input
							type="text"
							name="artist_spotify_ids"
							placeholder="e.g., 3n3Ppam7vgaVa1iaRUc9Lp, 06HL4z0CvFAxyc27GXpf02"
							class="input input-bordered w-full font-mono"
							pattern="^[A-Za-z0-9]{22}(\s*,\s*[A-Za-z0-9]{22})*$"
							required
						/>
					</label>
				</div>
				<div class="modal-action">
					<label for="add-song-modal" class="btn btn-ghost">Cancel</label>
					<button type="submit" class="btn btn-primary gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
						</svg>
						Add Song
					</button>
				</div>
			</form>
			<div id="add-song-feedback" class="mt-2"></div>
		</div>
		<label class="modal-backdrop" for="add-song-modal">Close</label>
	</div>
}

templ AddSongSuccessNotice(songTitle string) {
	<div id="add-song-feedback" class="mt-2" data-merge-mode="morph">
		<div class="alert alert-success">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
			</svg>
			<div class="flex-1">
				<p class="font-semibold">Song added</p>
				<p class="text-xs">{ songTitle }</p>
			</div>
			<label for="add-song-modal" class="btn btn-success btn-sm">Close</label>
		</div>
	</div>
}

templ NewSongCreateResponse(songTitle string, currentPlaylistSongs, waitingRemovalSongs []Song, notRecentCount int, playlistSort string) {
	@SongsSections(currentPlaylistSongs, waitingRemovalSongs, notRecentCount, playlistSort)
	@AddSongSuccessNotice(songTitle)
}
