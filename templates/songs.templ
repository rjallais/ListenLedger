package templates

// SongsPage renders the recent songs page
templ SongsPage(songs []Song) {
	@Layout("Recent Songs", "songs") {
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold">Recent Songs</h1>
			<label for="add-song-modal" class="btn btn-primary gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
				</svg>
				Add Song
			</label>
		</div>
		<p class="mb-4 text-base-content/70">Songs recently added to your collection</p>
		<div class="overflow-x-auto">
			<table class="table table-zebra">
				<thead>
					<tr>
						<th>Title</th>
						<th>Artist</th>
						<th>Release Date</th>
					</tr>
				</thead>
				<tbody id="songs-tbody">
					for _, song := range songs {
						@SongRow(song)
					}
				</tbody>
			</table>
		</div>
		@AddSongModal()
	}
}

// SongRow renders a single song table row
templ SongRow(song Song) {
	<tr id={ "song-" + song.ID }>
		<td class="font-medium">{ song.Title }</td>
		<td>{ song.ArtistName }</td>
		<td>{ song.ReleaseDate }</td>
	</tr>
}

// AddSongModal renders the modal for adding a new song.
templ AddSongModal() {
	<input type="checkbox" id="add-song-modal" class="modal-toggle"/>
	<div class="modal modal-bottom sm:modal-middle">
		<div class="modal-box">
			<h3 class="font-bold text-lg mb-4">Add New Song</h3>
			<form
				id="add-song-form"
				data-on:submit="evt.preventDefault(); @post('/api/songs', {contentType: 'form'})"
			>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Song Name *</span>
					</label>
					<label>
						<input
							type="text"
							name="name"
							placeholder="Enter song name"
							class="input input-bordered w-full"
							required
						/>
					</label>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Album / EP / Single *</span>
					</label>
					<label>
						<input
							type="text"
							name="album"
							placeholder="Enter release name"
							class="input input-bordered w-full"
							required
						/>
					</label>
				</div>
				<div class="form-control w-full mb-4">
					<label class="label">
						<span class="label-text">Release Year *</span>
					</label>
					<label>
						<input
							type="number"
							name="release_year"
							placeholder="e.g., 2024"
							min="1000"
							max="9999"
							class="input input-bordered w-full"
							required
						/>
					</label>
				</div>
				<div class="form-control w-full mb-6">
					<label class="label">
						<span class="label-text">Artist Spotify IDs *</span>
						<span class="label-text-alt text-base-content/50">Comma-separated for multiple</span>
					</label>
					<label>
						<input
							type="text"
							name="artist_spotify_ids"
							placeholder="e.g., 3n3Ppam7vgaVa1iaRUc9Lp, 06HL4z0CvFAxyc27GXpf02"
							class="input input-bordered w-full font-mono"
							pattern="^[A-Za-z0-9]{22}(\s*,\s*[A-Za-z0-9]{22})*$"
							required
						/>
					</label>
				</div>
				<div class="modal-action">
					<label for="add-song-modal" class="btn btn-ghost">Cancel</label>
					<button type="submit" class="btn btn-primary gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
						</svg>
						Add Song
					</button>
				</div>
			</form>
		</div>
		<label class="modal-backdrop" for="add-song-modal">Close</label>
	</div>
}

// NewSongRow prepends a newly created song row to the songs table.
templ NewSongRow(song Song) {
	<tbody id="songs-tbody" data-merge-mode="prepend">
		<tr id={ "song-" + song.ID } class="bg-success/10">
			<td class="font-medium">{ song.Title }</td>
			<td>{ song.ArtistName }</td>
			<td>{ song.ReleaseDate }</td>
		</tr>
	</tbody>
}
