package templates

// Base layout template with navigation
templ Layout(title string, activeNav string) {
	{{
		theme := ThemeFromContext(ctx)
		themeClass := ""
		if theme == "dark" {
			themeClass = "dark"
		} else if theme == "light" {
			themeClass = "light"
		}
	}}
	<!DOCTYPE html>
	<html
		lang="en"
		class={ themeClass }
		data-signals={ "{ theme: '" + theme + "' }" }
		data-class="{ light: $theme === 'light', dark: $theme === 'dark' }"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Music Collection</title>
			<meta name="description" content="Manage and track your personal music collection, albums, artists, and songs rotation."/>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎵</text></svg>"/>
		<!-- No imperative global listeners: dropdowns close via
			data-on:click__outside on native <details> elements, and Datastar
			aborts @get() SSE streams automatically when their element is
			detached or the document unloads (MPA navigation). -->
			<!-- Speculation Rules: Prerender same-origin view links on hover/pointerdown -->
			<script type="speculationrules">
			{
				"prerender": [
					{
						"where": {
							"and": [
								{ "href_matches": "/*" },
								{ "not": { "href_matches": "/_/*" } },
								{ "not": { "href_matches": "/api/*" } },
								{ "not": { "href_matches": "/static/*" } },
								{ "not": { "selector_matches": "[target]" } },
								{ "not": { "selector_matches": "[download]" } }
							]
						},
						"eagerness": "moderate"
					}
				]
			}
			</script>
			<!-- Open Props & OPUI Design System (zero build tooling) -->
			<link href={ AssetURL("styles.css") } rel="stylesheet" type="text/css"/>
			<!-- Datastar + Rocket (vendored locally; the import map shares one runtime module). -->
			@templ.JSONScript("", map[string]map[string]string{
				"imports": map[string]string{"datastar": AssetURL("datastar.js")},
			}).WithType("importmap")
			<script type="module">
				function bootDatastar() {
					import('datastar');
				}
				if (document.prerendering) {
					document.addEventListener('prerenderingchange', bootDatastar, { once: true });
				} else {
					bootDatastar();
				}
			</script>
			<script type="module" src={ AssetURL("sb-modal.js") } defer></script>
		</head>
		<body class="min-h-screen bg-base-200">
			<a href="#main-content" class="skip-link sr-only">Skip to content</a>
			if IsDevEnvironment() {
				<div id="hotreload-container" data-init="@get('/reload', {retryMaxCount: Infinity, retryInterval: 300, retryMaxWait: 2000})"></div>
			}
			@Navbar(activeNav)
			<main id="main-content" tabindex="-1" class="container mx-auto p-4 md:p-6 outline-none">
				{ children... }
			</main>
			<div id="artist-history-drawer-container"></div>
		</body>
	</html>
}

// Navbar component
templ Navbar(activeNav string) {
	<div class="navbar bg-base-100 shadow-sm sticky top-0 z-50">
		<!-- Logo -->
		<div class="navbar-start">
			<a href="/" class="btn btn-ghost text-xl gap-2 font-bold tracking-tight">
				<span>🎵</span>
				<span class="hidden sm:inline">Music Collection</span>
			</a>
		</div>
		<!-- Center Navigation -->
		<div class="navbar-center">
			<ul class="menu menu-horizontal px-1 gap-1">
				@NavLink("/albums", "💿", "Albums", activeNav == "albums")
				@NavLink("/artists", "🎤", "Artists", activeNav == "artists")
				@NavLink("/songs", "🎵", "Songs", activeNav == "songs")
				@NavLinkExternal("/_/", "⚙️", "Admin")
			</ul>
		</div>
		<!-- Right Side -->
		<div class="navbar-end gap-2">
			@ThemeSwitcher()
			@QueueJobsWidget()
			@SSEIndicator()
		</div>
	</div>
}

// NavLink renders a navigation link
templ NavLink(href, icon, label string, active bool) {
	<li>
		<a href={ templ.SafeURL(href) } class={ "gap-2", templ.KV("nav-active", active) }>
			{ icon }
			<span class="hidden md:inline">{ label }</span>
		</a>
	</li>
}

// NavLinkExternal renders an external navigation link
templ NavLinkExternal(href, icon, label string) {
	<li>
		<a href={ templ.SafeURL(href) } target="_blank" class="gap-2">
			{ icon }
			<span class="hidden md:inline">{ label }</span>
		</a>
	</li>
}

// ThemeSwitcher renders the Open Props theme toggle (Light / Dark / System)
templ ThemeSwitcher() {
	<div
		class="theme-switcher"
		data-signals="{
			themes: ['light', 'dark', 'system']
		}"
	>
		<button
			type="button"
			data-on:click="
				$theme = $themes[($themes.indexOf($theme) + 1) % $themes.length];
				@post('/api/theme/' + $theme);
			"
			class="theme-button btn btn-sm btn-ghost btn-circle"
			aria-label="Switch theme"
			title="Switch theme"
		>
			<span class="icon theme-icon"></span>
		</button>
	</div>
}

// ThemeButton renders a single theme button
templ ThemeButton(theme Theme) {
	<button
		type="button"
		class="btn btn-sm btn-ghost justify-start gap-2 theme-option"
		data-theme={ theme.Value }
		data-on:click={ "$theme = '" + theme.Value + "'; @post('/api/theme/" + theme.Value + "')" }
		data-class:active={ "$theme === '" + theme.Value + "'" }
	>
		{ theme.Icon } { theme.Name }
	</button>
}

// SSEIndicator shows the live connection status
templ SSEIndicator() {
	<div
		id="sse-indicator-container"
		class="flex items-center gap-2"
		data-signals="{_sseStatus: 'connected'}"
		data-init="@get('/api/events', {openWhenHidden: false, retry: 'always', retryMaxCount: Infinity, retryInterval: 1000, retryMaxWait: 30000})"
		data-on:datastar-fetch="if (evt.detail.type === 'retrying') { $_sseStatus = 'reconnecting' } else if (evt.detail.type === 'error' || evt.detail.type === 'retries-failed') { $_sseStatus = 'disconnected' } else if (evt.detail.type === 'started') { $_sseStatus = 'connected' }"
	>
		<span
			id="sse-indicator"
			class="badge badge-xs badge-success"
			data-class="{ 'badge-success': $_sseStatus === 'connected', 'badge-warning animate-pulse': $_sseStatus === 'reconnecting', 'badge-error': $_sseStatus === 'disconnected' }"
		></span>
		<span
			class="text-sm opacity-70 hidden sm:inline"
			data-text="$_sseStatus === 'reconnecting' ? 'Reconnecting' : ($_sseStatus === 'disconnected' ? 'Disconnected' : 'Live')"
		>Live</span>
	</div>
}

// QueueJobsWidget shows lightweight queue + job health stats pushed via Datastar SSE.
templ QueueJobsWidget() {
	@QueueJobsWidgetContent(QueueStats{})
}

// QueueJobsWidgetContent renders the contents of the queue health widget.
// The widget is patched from the backend over SSE, so it is marked as a
// polite live region for screen readers (Tao of Datastar: accessibility).
templ QueueJobsWidgetContent(stats QueueStats) {
	<div
		id="queue-jobs-widget"
		class="hidden lg:flex items-center gap-2"
		aria-live="polite"
		aria-atomic="true"
	>
		<span class="badge badge-outline badge-sm font-mono" title="JetStream pending messages">
			Q:<span>{ FormatUint(stats.QueuePending) }</span>
		</span>
		<span class="badge badge-outline badge-sm font-mono" title="In-flight (unacked) messages">
			A:<span>{ FormatUint(stats.QueueAckPending) }</span>
		</span>
		<span class="badge badge-error badge-sm font-mono" title="Failed jobs">
			F:<span>{ FormatInt64(stats.JobsFailed) }</span>
		</span>
		<button
			type="button"
			class="btn btn-xs btn-warning gap-1"
			title="Force retries until queued and failed are zero"
			data-indicator:_retrying
			data-attr:disabled="$_retrying"
			data-on:click="@post('/api/queue/retry')"
		>
			<span data-show="$_retrying" class="loading loading-spinner loading-xs" style="display: none"></span>
			<span>Force Retry</span>
		</button>
		if stats.QueueRedelivered > 0 {
			<span
				class="badge badge-error badge-sm font-mono"
				title="Redelivered (unacked) messages"
			>
				R:<span>{ FormatUint(stats.QueueRedelivered) }</span>
			</span>
		}
	</div>
}
