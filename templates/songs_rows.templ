package templates

import "fmt"

// SongRow renders a single song row.
templ SongRow(song Song, playlistSort string) {
	<tr
		id={ "song-" + song.ID }
		data-order-added={ fmt.Sprint(song.OrderAdded) }
		data-order-release={ fmt.Sprint(song.OrderRelease) }
	>
		<td class="font-medium">{ song.Title }</td>
		<td>{ song.ArtistName }</td>
		<td>{ song.Album }</td>
		@SongReleaseTypeCell(song.ReleaseType)
		<td>{ song.ReleaseDate }</td>
		@SongBatchCell(song.BatchSeq, song.BatchPos)
		@SongRecentToggleCell(song.ID, song.Title, song.IsRecent, playlistSort)
	</tr>
}

templ SongReleaseTypeCell(releaseType string) {
	<td>
		if releaseType != "" {
			<span class="badge badge-outline badge-sm">{ releaseType }</span>
		}
	</td>
}

templ SongBatchCell(batchSeq, batchPos int) {
	<td class="text-center">
		if batchSeq > 0 {
			<span class="badge badge-primary badge-sm">{ fmt.Sprintf("B%d.%d", batchSeq, batchPos) }</span>
		} else {
			<span class="text-base-content/40">—</span>
		}
	</td>
}

// SongRecentToggleCell renders a plain checkbox. It deliberately carries no
// data-* bindings: the change is handled by one delegated data-on:change on the
// enclosing <tbody> (see songRecentChangeAction). Per-row bindings meant ~2000
// Datastar effects that were torn down and rebuilt whenever a row moved.
templ SongRecentToggleCell(songID, songTitle string, isRecent bool, playlistSort string) {
	<td class="text-center">
		<input
			type="checkbox"
			class="checkbox checkbox-sm checkbox-primary cursor-pointer"
			aria-label={ fmt.Sprintf("Mark %s as recently added", songTitle) }
			checked?={ isRecent }
			data-song-id={ songID }
		/>
	</td>
}

// songRecentChangeAction is the delegated change handler for a songs <tbody>.
// Disabling the clicked checkbox prevents double submits; the SSE response
// morphs the sections, which restores it. Only one row toggle may be in flight
// per tbody: a second change is reverted so the document-scoped failure
// handler can identify the single disabled checkbox. The prior checked state is
// stashed so songRecentFetchAction can restore it if the fetch fails
// before any morph lands.
func songRecentChangeAction() string {
	return "if (evt.target.dataset.songId) { const tbody = evt.target.closest('tbody'); if (tbody && tbody.querySelector('input[data-song-id]:disabled')) { evt.target.checked = !evt.target.checked; return; } evt.target.dataset.wasChecked = String(!evt.target.checked); evt.target.disabled = true; @post('/api/songs/' + encodeURIComponent(evt.target.dataset.songId) + '/recent/' + evt.target.checked + '?playlist_sort=' + encodeURIComponent($_playlist_sort)) }"
}

// songRecentFetchAction handles the document-scoped datastar-fetch events for
// recent toggles. The response was rendered with the sort captured when the
// request started, so a user who changed sort while it was pending would get
// the older order back; after a successful morph, reapply the current local
// sort. On failure, restore the single in-flight checkbox per tbody from the
// stashed pre-click state.
func songRecentFetchAction() string {
	return "if (evt.detail.el) { const songsTbodies = ['songs-current', 'songs-waiting-removal', 'songs-not-recent']; if (evt.detail.type === 'finished' && songsTbodies.includes(evt.detail.el.id)) { sortSongsTable($_playlist_sort); return; } if (evt.detail.type === 'error' || evt.detail.type === 'retries-failed') { const box = evt.detail.el.querySelector('input[data-song-id]:disabled'); if (box) { box.disabled = false; if (box.dataset.wasChecked !== undefined) { box.checked = box.dataset.wasChecked === 'true' } } } }"
}
