package templates

import "strconv"

templ BatchRefreshResult(batchID string, total int, completed int, stats map[string]int, done bool) {
	<div id="batch-refresh-result" class="mt-4" data-batch-done={ boolString(done) } aria-live="polite" aria-atomic="true">
		if total == 0 && done {
			@BatchRefreshEmptyAlert()
		} else if done {
			@BatchRefreshCompleteAlert(completed, total)
			if batchID != "" {
				@BatchRefreshID(batchID)
			}
			@BatchRefreshProgress(completed, total)
		} else {
			@BatchRefreshRunningAlert(total, stats)
			if batchID != "" {
				@BatchRefreshID(batchID)
			}
			@BatchRefreshProgress(completed, total)
		}
	</div>
}

templ BatchRefreshEmptyAlert() {
	<div class="alert alert-warning">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M5 3h14l2 3v12l-2 3H5l-2-3V6l2-3z"></path>
		</svg>
		<div class="flex-1">
			<h4 class="font-bold">No Artists Queued</h4>
			<p class="text-sm">No eligible artists were queued in this attempt.</p>
		</div>
		<button type="button" class="btn btn-warning btn-sm" data-sb-close>Close</button>
	</div>
}

templ BatchRefreshRunningAlert(queued int, stats map[string]int) {
	<div class="alert alert-info">
		<span class="loading loading-spinner loading-sm"></span>
		<div class="flex-1">
			<h4 class="font-bold">Batch Refresh Running</h4>
			<div class="text-sm">
				{ batchQueuedSummary(queued) }
				@BatchPriorityStats(stats)
			</div>
		</div>
		<button type="button" class="btn btn-ghost btn-sm" data-sb-close>Close</button>
	</div>
}

templ BatchPriorityStats(stats map[string]int) {
	<div class="mt-1 text-xs flex flex-wrap gap-x-3 gap-y-1">
		for _, stat := range batchPriorityStats(stats) {
			<span>{ stat.Label }: { stat.Count }</span>
		}
	</div>
}

templ BatchRefreshCompleteAlert(completed, total int) {
	<div class="alert alert-success">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
		</svg>
		<div class="flex-1">
			<h4 class="font-bold">Batch Refresh Complete</h4>
			<p class="text-sm">Processed { strconv.Itoa(completed) } / { strconv.Itoa(total) } artists</p>
		</div>
		<button type="button" class="btn btn-success btn-sm" data-sb-close>Close</button>
	</div>
}

templ BatchRefreshErrorAlert(errMsg string) {
	<div id="batch-refresh-result" class="mt-4" aria-live="polite" aria-atomic="true">
		<div class="alert alert-error">
			<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
			<div class="flex-1">
				<h4 class="font-bold">Batch Refresh Error</h4>
				<p class="text-sm">{ errMsg }</p>
			</div>
			<button type="button" class="btn btn-ghost btn-sm" data-sb-close>Close</button>
		</div>
	</div>
}

templ BatchRefreshID(batchID string) {
	<div class="mt-2 text-[11px] font-mono text-base-content/50">{ batchIDText(batchID) }</div>
}

templ BatchRefreshProgress(completed, total int) {
	<div class="mt-3">
		<div class="flex items-center justify-between text-xs text-base-content/70 mb-1">
			<span>Progress: { strconv.Itoa(completed) } / { strconv.Itoa(total) }</span>
			if total > 0 {
				<span>{ strconv.Itoa(completed * 100 / total) }%</span>
			} else {
				<span>0%</span>
			}
		</div>
		<progress class="progress progress-primary w-full" value={ strconv.Itoa(completed) } max={ strconv.Itoa(max(total, 1)) }>{ strconv.Itoa(completed) }</progress>
	</div>
}
