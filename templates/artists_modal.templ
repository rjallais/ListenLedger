package templates

// AddArtistModal renders the modal for adding a new artist.
//
// Declarative open state: triggers set $_add_artist_open; sb-modal reflects
// the open attribute through its bool prop and resets the signal on sb-close
// (button, backdrop, or Escape). The backend can drive it via patch-signals.
templ AddArtistModal(currentGenre string) {
	<sb-modal
		data-signals="{_add_artist_open: false}"
		data-attr:open="$_add_artist_open"
		data-on:sb-close="$_add_artist_open = false"
		heading="Add New Artist"
	>
		@AddArtistForm(currentGenre)
		<div id="add-artist-feedback" class="mt-2"></div>
		@AddArtistModalActions()
	</sb-modal>
}

// AddArtistForm renders the form for adding a new artist.
templ AddArtistForm(currentGenre string) {
	<form
		id="add-artist-form"
		data-indicator:_add_artist_loading
		data-on:submit__prevent="@post('/api/artists', {contentType: 'form'})"
	>
		@AddArtistNameField()
		@AddArtistSpotifyIDField()
		@AddArtistGenreField(currentGenre)
		@AddArtistStatusField()
		@AddArtistOptionalFields()
	</form>
}

templ AddArtistNameField() {
	<div class="form-control w-full mb-4">
		<label class="label" for="artist-name">
			<span class="label-text">Artist Name *</span>
		</label>
		<input
			id="artist-name"
			type="text"
			name="name"
			placeholder="Enter artist name"
			class="input input-bordered w-full"
			required
		/>
	</div>
}

templ AddArtistSpotifyIDField() {
	<div class="form-control w-full mb-4">
		<label class="label" for="spotify-id">
			<span class="label-text">Artist ID (Spotify ID) *</span>
		</label>
		<input
			id="spotify-id"
			type="text"
			name="spotify_id"
			placeholder="e.g., 0L8ExT028jH3ddEcZwqJJ5"
			class="input input-bordered w-full font-mono"
			pattern="^[A-Za-z0-9]{22}$"
			minlength="22"
			maxlength="22"
			title="Spotify ID must be exactly 22 alphanumeric characters."
			required
		/>
	</div>
}

templ AddArtistGenreField(currentGenre string) {
	<div class="form-control w-full mb-4">
		<label class="label" for="genre-group">
			<span class="label-text">Genre Group</span>
		</label>
		<select id="genre-group" name="genre_group" class="select select-bordered w-full">
			for _, option := range artistGenreOptions(currentGenre) {
				@SelectOption(option)
			}
		</select>
	</div>
}

templ AddArtistStatusField() {
	<div class="form-control w-full mb-4">
		<label class="label" for="list-status">
			<span class="label-text">Initial Status</span>
		</label>
		<select id="list-status" name="list_status" class="select select-bordered w-full">
			for _, option := range artistListStatusOptions() {
				@SelectOption(option)
			}
		</select>
	</div>
}

templ AddArtistOptionalFields() {
	<div class="grid grid-cols-2 gap-4 mb-6">
		<div class="form-control w-full">
			<label class="label" for="monthly-listeners">
				<span class="label-text">Monthly Listeners</span>
				<span class="label-text-alt text-base-content/50">Optional</span>
			</label>
			<input
				id="monthly-listeners"
				type="number"
				name="monthly_listeners"
				placeholder="0"
				min="0"
				class="input input-bordered w-full"
			/>
		</div>
		<div class="form-control w-full">
			<label class="label" for="collection-songs">
				<span class="label-text">Collection Songs</span>
				<span class="label-text-alt text-base-content/50">Optional</span>
			</label>
			<input
				id="collection-songs"
				type="number"
				name="collection_songs"
				placeholder="0"
				min="0"
				class="input input-bordered w-full"
			/>
		</div>
	</div>
}

templ AddArtistModalActions() {
	<div slot="footer" class="flex justify-end gap-2">
		<button type="button" class="btn btn-ghost" data-sb-close>Cancel</button>
		<button type="submit" form="add-artist-form" class="btn btn-primary gap-2" data-attr:disabled="$_add_artist_loading">
			<span data-show="$_add_artist_loading" class="loading loading-spinner loading-xs" style="display: none"></span>
			<svg data-show="!$_add_artist_loading" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
			</svg>
			Add Artist
		</button>
	</div>
}

templ SelectOption(option selectOption) {
	<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
}

templ AddArtistSuccessNotice(artistName string) {
	<div id="add-artist-feedback" class="mt-2" data-signals="{ _feedbackVisible: true }" data-show="$_feedbackVisible">
		<div class="alert alert-success">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
			</svg>
			<div class="flex-1">
				<p class="font-semibold">Artist added</p>
				<p class="text-xs">{ artistName }</p>
			</div>
			<button type="reset" form="add-artist-form" class="btn btn-success btn-sm" data-on:click="$_feedbackVisible = false">Add Another</button>
			<button type="button" class="btn btn-ghost btn-sm" data-sb-close>Close</button>
		</div>
	</div>
}

templ AddArtistErrorNotice(errMsg string) {
	<div id="add-artist-feedback" class="mt-2" data-signals="{ _feedbackVisible: true }" data-show="$_feedbackVisible">
		<div class="alert alert-error">
			<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
			<div class="flex-1">
				<p class="font-semibold">Failed to add artist</p>
				<p class="text-xs">{ errMsg }</p>
			</div>
			<button type="button" class="btn btn-ghost btn-sm" data-on:click="$_feedbackVisible = false">Dismiss</button>
		</div>
	</div>
}
