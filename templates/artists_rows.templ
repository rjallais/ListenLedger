package templates

import "net/url"

// ArtistsTable renders the artists data table.
//
// The wrapper refetches its visible page slice whenever the genre's rank tick
// signal is patched (server emits one tick per total_songs recalculation).
// data-on-signal-patch fires only on actual signal patches — unlike
// data-effect there is no refetch on page load and no refetch when unrelated
// signals change. data-signals__ifmissing guarantees the tick signal exists
// before the filter ever evaluates it.
templ ArtistsTable(artists []Artist, currentGenre string, page, limit int) {
	<div
		class="overflow-x-auto ledger-frame"
		data-signals__ifmissing={ "{ " + RanksTickSignal(currentGenre) + ": 0}" }
		data-on-signal-patch={ "@get('/api/artists/tbody?genre=" + url.QueryEscape(currentGenre) + "&page=" + intString(page) + "&limit=" + intString(limit) + "&tick=' + $" + RanksTickSignal(currentGenre) + ")" }
		data-on-signal-patch-filter={ "{include: /^" + RanksTickSignal(currentGenre) + "$/}" }
	>
		<table class="table table-zebra">
			<thead>
				<tr>
					<th>Name</th>
					<th class="text-right">Monthly Listeners</th>
					<th class="text-center">List Status</th>
					<th class="text-center">Collection</th>
					<th>Last Updated</th>
					<th class="text-center">Actions</th>
				</tr>
			</thead>
			@ArtistsTableBody(artists, currentGenre)
		</table>
	</div>
}

templ ArtistsTableBody(artists []Artist, currentGenre string) {
	<tbody id={ artistsTBodyID(currentGenre) }>
		for _, artist := range artists {
			@ArtistRow(artist)
		}
	</tbody>
}

// ArtistRow renders a single artist table row.
templ ArtistRow(artist Artist) {
	<tr id={ artistRowID(artist.ID) }>
		@ArtistRowContent(artist)
	</tr>
}

templ ArtistRowContent(artist Artist) {
	<td class="font-medium">
		<button
			type="button"
			class="hover:underline text-left cursor-pointer bg-transparent border-none p-0 text-foreground font-medium flex items-center gap-1.5"
			data-on:click={ artistHistoryDrawerAction(artist.ID) }
			title="View listener trajectory"
		>
			<span>{ artist.Name }</span>
		</button>
	</td>
	<td class="text-right font-mono">
		<span id={ artistListenerElementID(artist.ID) }>{ FormatNumber(artist.MonthlyListeners) }</span>
	</td>
	<td class="text-center">
		<div class="flex justify-center">
			@ListStatusDropdown(artist.ID, artist.ListStatus)
		</div>
	</td>
	<td class="text-center">
		@ArtistCollectionControls(artist)
	</td>
	<td>
		<span id={ artistUpdatedElementID(artist.ID) } title={ artist.LastUpdatedFull }>{ artist.LastUpdated }</span>
	</td>
	<td class="text-center">
		@ArtistRefreshAction(artist)
	</td>
}
